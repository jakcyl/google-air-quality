{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Home Assistant",
      "type": "debugpy",
      "request": "launch",
      "module": "homeassistant",
      "args": ["--config", "${workspaceFolder}/config", "--debug"],
      "env": { "PYTHONPATH": "${workspaceFolder}/custom_components" },
      "justMyCode": false
    },
    {
      "name": "Pytest current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}"],
      "justMyCode": false
    },
    {
      "name": "gaqi CLI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/gaqi",
      "args": [],
      "justMyCode": false
    }
  ]
}
